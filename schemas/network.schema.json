{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.web8.network/schemas/v1/network.schema.json",
  "title": "Kinetic Network Genesis Manifest Schema",
  "description": "JSON schema for declarative Kinetic sovereign network configurations (network.json).",
  "type": "object",
  "required": [
    "network",
    "drand",
    "governance",
    "consensus",
    "advanced"
  ],
  "properties": {
    "network": {
      "type": "object",
      "required": ["nsp", "base_domain", "local_bind_ip", "bootstrap_nodes"],
      "properties": {
        "nsp": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "description": "Namespace / Top-Level Domain for this network (e.g. 'kin', 'uni')."
        },
        "base_domain": {
          "type": "string",
          "description": "Primary base domain for web documentation and bridge resources."
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "local_bind_ip": {
          "type": "string",
          "default": "127.0.0.2"
        },
        "bootstrap_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of multiaddresses for initial DHT bootstrap peers."
        }
      }
    },
    "drand": {
      "type": "object",
      "required": ["drand_genesis_time", "drand_period", "kinetic_genesis_kyn", "drand_public_key", "drand_http_endpoints"],
      "properties": {
        "drand_genesis_time": {
          "type": "integer"
        },
        "drand_period": {
          "type": "integer",
          "description": "Beacon period in seconds (e.g. 3 for Quicknet)."
        },
        "kinetic_genesis_kyn": {
          "type": "integer"
        },
        "drand_public_key": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]+$"
        },
        "drand_http_endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": ["governance_model", "max_age_kyns"],
      "properties": {
        "governance_model": {
          "type": "string",
          "enum": ["sovereign", "council", "immutable"]
        },
        "max_age_kyns": {
          "type": "integer"
        }
      }
    },
    "consensus": {
      "type": "object",
      "required": ["ndc_multipliers", "vdf_max_iterations", "minimum_commit_age_kyns"],
      "properties": {
        "ndc_multipliers": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "vdf_discount_min_iterations": {
          "type": "integer"
        },
        "vdf_discount_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "vdf_max_iterations": {
          "type": "integer"
        },
        "vdf_max_proof_bytes": {
          "type": "integer"
        },
        "minimum_commit_age_kyns": {
          "type": "integer"
        }
      }
    },
    "advanced": {
      "type": "object",
      "required": ["benchmark_base_iterations", "benchmark_target_minutes", "m_redundancy", "limits", "timeouts"],
      "properties": {
        "benchmark_base_iterations": {
          "type": "integer"
        },
        "benchmark_target_minutes": {
          "type": "number"
        },
        "steal_target_kyns": {
          "type": "integer"
        },
        "m_redundancy": {
          "type": "integer",
          "minimum": 1
        },
        "limits": {
          "type": "object",
          "properties": {
            "p2p_max_packet_size": { "type": "integer" },
            "p2p_max_circuit_bytes": { "type": "integer" },
            "proxy_max_body_bytes": { "type": "integer" },
            "storage_max_value_bytes": { "type": "integer" },
            "kid_max_public_key_bytes": { "type": "integer" },
            "kid_max_location_bytes": { "type": "integer" },
            "kid_max_endpoint_bytes": { "type": "integer" },
            "drand_max_response_bytes": { "type": "integer" },
            "lru_cache_size": { "type": "integer" }
          }
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "idle_timeout_seconds": { "type": "integer" },
            "dns_cache_ttl_seconds": { "type": "integer" },
            "network_prune_interval_seconds": { "type": "integer" },
            "host_route_max_age_seconds": { "type": "integer" }
          }
        }
      }
    }
  }
}
